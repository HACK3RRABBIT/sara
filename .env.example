# Copy to .env next to docker-compose.yml
# Generate each value separately with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Same URL you open in the browser. Use https://your-domain for a real server.
BETTER_AUTH_URL=http://localhost:8080
PORT=8080
# Extra addresses you also open the app from — e.g. your machine's LAN IP so
# phones/other devices on the network can sign in too. Comma-separated full
# origins (scheme://host:port). Leave empty if you only ever use BETTER_AUTH_URL.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.50:8080,http://192.168.1.50:8090
